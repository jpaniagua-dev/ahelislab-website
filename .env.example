# The build reads process environment variables; this file is only a template.
# Example: SITE_URL=https://example.ch CONTACT_EMAIL=contact@example.ch SITE_INDEXABLE=true npm run build
SITE_URL=
CONTACT_EMAIL=hello@ahelislab.ch
SITE_INDEXABLE=false
# Server only. Store these values in /etc/ahelis-contact.env, never in dist/.
RESEND_API_KEY=
CONTACT_FROM="Ahelis Lab <hello@ahelislab.ch>"
CONTACT_ALLOWED_ORIGINS=https://ahelis.ch,https://ahelislab.ch
CONTACT_PORT=4201

{
  "name": "ahelislab-website",
  "version": "0.10.3",
  "private": true,
  "type": "module",
  "description": "Ahelis Lab static agency website with SEO and interactive motion design.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:vault": "node scripts/build.mjs --site vault",
    "build:business": "node scripts/build.mjs --site business",
    "dev:business": "node scripts/dev.mjs --site business --port 3012",
    "check:business": "node scripts/verify-business.mjs",
    "dev:vault": "node scripts/dev.mjs --site vault --port 3011",
    "check:vault": "node scripts/verify-vault.mjs",
    "test:download": "node --test tests/download.test.mjs",
    "check": "node scripts/verify.mjs",
    "check:motion": "node scripts/verify-motion.cjs",
    "test:contact": "node --test tests/contact.test.mjs",
    "start:contact": "node server/contact.mjs",
    "start": "node scripts/dev.mjs"
  }
}
